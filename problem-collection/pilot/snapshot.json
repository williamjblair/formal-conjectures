":"OeisA103662.conjecture.variants.a_40","text":"$a(40)$, if it exists, is not known.\n\nThis claim is rooted in the finiteness conjecture. The most direct mathematical expression\nof the open problem concerning $a(40)$ is the negation of the existence of a valid base."}],"retention_basis":{"attribution":"OEIS Foundation Inc. and contributors, sequence A103662","derivation":"Exact normalized Formal Conjectures declaration docstring from the bound Git revision.","license_spdx":"CC-BY-SA-4.0","retained_bytes":true,"retention_permission":"redistribution-permitted-under-license","source_locator":"https://oeis.org/A103662","source_rights_class":"OEIS material (CC-BY-SA-4.0)"}},"relations":[{"kind":"variant_of","problem_id":"formal-conjectures:oeis:A103662:conjecture"}],"rights":{"formal_conjectures_record":{"attribution":"The Formal Conjectures Authors","license_spdx":"CC-BY-4.0","retention_permission":"redistribution-permitted-with-attribution"},"lean_source":{"attribution":"The Formal Conjectures Authors","license_spdx":"Apache-2.0","retention_permission":"redistribution-permitted-under-license"},"question_text":{"attribution":"OEIS Foundation Inc. and contributors, sequence A103662","derivation":"Exact normalized Formal Conjectures declaration docstring from the bound Git revision.","license_spdx":"CC-BY-SA-4.0","retained_bytes":true,"retention_permission":"redistribution-permitted-under-license","source_locator":"https://oeis.org/A103662","source_rights_class":"OEIS material (CC-BY-SA-4.0)"},"third_party_source":{"attribution":"OEIS Foundation Inc. and contributors, sequence A103662","caveat":"Only the attributed tracked docstring is retained as question text; no source-page or paper bytes are retained.","license_spdx":"CC-BY-SA-4.0","locator":"https://oeis.org/A103662","retained_bytes":false,"retention_permission":"not-retained"}},"source_identity":{"component":"a-40","source_collection":"OEIS","source_key":"A103662"},"status":{"asserted_by":"Formal Conjectures trac