{
  "$id": "https://github.com/google-deepmind/formal-conjectures/problem-collection/problem-collection-snapshot-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_effect": {
      "const": "none"
    },
    "collection_id": {
      "const": "formal-conjectures/research-open-pilot"
    },
    "data": {
      "additionalProperties": false,
      "properties": {
        "declaration_routes": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "declaration": {
                "minLength": 1,
                "type": "string"
              },
              "disposition": {
                "enum": [
                  "excluded",
                  "included"
                ]
              }
            },
            "required": [
              "declaration",
              "disposition"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "exclusions": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "category": {
                "type": "string"
              },
              "declaration": {
                "minLength": 1,
                "type": "string"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "reason_code": {
                "enum": [
                  "excluded_category",
                  "source_locator_missing",
                  "question_text_rights_unresolved"
                ]
              },
              "source_path": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "category",
              "declaration",
              "reason",
              "reason_code",
              "source_path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "groups": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "group_id": {
                "pattern": "^formal-conjectures:group:[A-Za-z0-9:._-]+$",
                "type": "string"
              },
              "history": {
                "items": {
                  "$ref": "#/$defs/history"
                },
                "minItems": 1,
                "type": "array"
              },
              "kind": {
                "enum": [
                  "multipart",
                  "variant-set"
                ]
              },
              "member_problem_ids": {
                "items": {
                  "pattern": "^formal-conjectures:[A-Za-z0-9][A-Za-z0-9:._-]*$",
                  "type": "string"
                },
                "minItems": 2,
                "type": "array"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "group_id",
              "history",
              "kind",
              "member_problem_ids",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "problems": {
          "items": {
            "$ref": "#/$defs/problem"
          },
          "maxItems": 10,
          "minItems": 5,
          "type": "array"
        }
      },
      "required": [
        "declaration_routes",
        "exclusions",
        "groups",
        "problems"
      ],
      "type": "object"
    },
    "nonclaims": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "roots": {
      "additionalProperties": false,
      "properties": {
        "data_root": {
          "$ref": "#/$defs/digest"
        },
        "profile_root": {
          "$ref": "#/$defs/digest"
        },
        "registry_root": {
          "$ref": "#/$defs/digest"
        },
        "snapshot_root": {
          "$ref": "#/$defs/digest"
        },
        "tracked_input_root": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "data_root",
        "profile_root",
        "registry_root",
        "snapshot_root",
        "tracked_input_root"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "source_snapshot": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "data_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generator_path": {
          "const": "scripts/build_problem_collection.py"
        },
        "inventory_path": {
          "const": "problem-collection/pilot/candidate-metadata-v2.json"
        },
        "profile_path": {
          "const": "problem-collection/profile-v1.json"
        },
        "registry_path": {
          "const": "problem-collection/pilot/registry.json"
        },
        "schema_path": {
          "const": "problem-collection/schema/problem-collection-snapshot-v1.schema.json"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tracked_inputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "minLength": 1,
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/digest"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "commit",
        "data_paths",
        "generator_path",
        "inventory_path",
        "profile_path",
        "registry_path",
        "schema_path",
        "tags",
        "tracked_inputs"
      ],
      "type": "object"
    }
  },
  "required": [
    "authority_effect",
    "collection_id",
    "data",
    "nonclaims",
    "roots",
    "schema_version",
    "source_snapshot"
  ],
  "type": "object",
  "$defs": {
    "declaration": {
      "additionalProperties": true,
      "properties": {
        "category": {
          "const": "research open"
        },
        "docstring_sha256": {
          "$ref": "#/$defs/digest"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "relationship": {
          "enum": [
            "generalization",
            "part",
            "primary",
            "variant"
          ]
        },
        "source_path": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "category",
        "docstring_sha256",
        "name",
        "relationship",
        "source_path"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "history": {
      "additionalProperties": true,
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "event": {
          "enum": [
            "merged",
            "registered",
            "renamed",
            "split",
            "superseded"
          ]
        },
        "note": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "date",
        "event",
        "note"
      ],
      "type": "object"
    },
    "problem": {
      "additionalProperties": false,
      "properties": {
        "declarations": {
          "items": {
            "$ref": "#/$defs/declaration"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_identity": {
          "additionalProperties": false,
          "properties": {
            "component": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            "source_key": {
              "minLength": 1,
              "type": "string"
            },
            "source_collection": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "component",
            "source_collection",
            "source_key"
          ],
          "type": "object"
        },
        "group_ids": {
          "items": {
            "pattern": "^formal-conjectures:group:[A-Za-z0-9:._-]+$",
            "type": "string"
          },
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/history"
          },
          "minItems": 1,
          "type": "array"
        },
        "identity_basis": {
          "additionalProperties": false,
          "properties": {
            "source_path": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "source_path"
          ],
          "type": "object"
        },
        "problem_id": {
          "pattern": "^formal-conjectures:[A-Za-z0-9][A-Za-z0-9:._-]*$",
          "type": "string"
        },
        "question": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "verbatim_normalized_docstrings"
            },
            "parts": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "declaration": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "text": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "declaration",
                  "text"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "retention_basis": {
              "$ref": "#/$defs/questionRights"
            }
          },
          "required": [
            "kind",
            "parts",
            "retention_basis"
          ],
          "type": "object"
        },
        "relations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "composed_of",
                  "part_of",
                  "variant_of"
                ]
              },
              "problem_id": {
                "pattern": "^formal-conjectures:[A-Za-z0-9][A-Za-z0-9:._-]*$",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "problem_id"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "rights": {
          "additionalProperties": false,
          "properties": {
            "formal_conjectures_record": {
              "$ref": "#/$defs/rightsEntry"
            },
            "lean_source": {
              "$ref": "#/$defs/rightsEntry"
            },
            "question_text": {
              "$ref": "#/$defs/questionRights"
            },
            "third_party_source": {
              "allOf": [
                {
                  "$ref": "#/$defs/rightsEntry"
                },
                {
                  "properties": {
                    "caveat": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "locator": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "retained_bytes": {
                      "const": false
                    }
                  },
                  "required": [
                    "caveat",
                    "locator",
                    "retained_bytes"
                  ]
                }
              ]
            }
          },
          "required": [
            "formal_conjectures_record",
            "lean_source",
            "question_text",
            "third_party_source"
          ],
          "type": "object"
        },
        "status": {
          "additionalProperties": false,
          "properties": {
            "asserted_by": {
              "minLength": 1,
              "type": "string"
            },
            "evidence": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "declaration": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "metadata_module": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "source_category": {
                    "const": "research open"
                  },
                  "source_path": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "declaration",
                  "metadata_module",
                  "source_category",
                  "source_path"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "last_checked_revision": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "metadata_schema_version": {
              "const": 2
            },
            "method": {
              "minLength": 1,
              "type": "string"
            },
            "reviewed_on": {
              "format": "date",
              "type": "string"
            },
            "reviewer_kind": {
              "enum": [
                "AI",
                "human"
              ]
            },
            "reviewer_name": {
              "minLength": 1,
              "type": "string"
            },
            "value": {
              "const": "source-asserted-research-open"
            }
          },
          "required": [
            "asserted_by",
            "evidence",
            "last_checked_revision",
            "metadata_schema_version",
            "method",
            "reviewed_on",
            "reviewer_kind",
            "reviewer_name",
            "value"
          ],
          "type": "object"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "title_basis": {
          "additionalProperties": true,
          "properties": {
            "kind": {
              "enum": [
                "declaration_docstring",
                "module_heading"
              ]
            },
            "source_path": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_path"
          ],
          "type": "object"
        },
        "upstream_identity": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "enum": [
                "MathOverflow",
                "OEIS"
              ]
            }
          },
          "required": [
            "id",
            "provider"
          ],
          "type": "object"
        }
      },
      "required": [
        "declarations",
        "history",
        "identity_basis",
        "problem_id",
        "question",
        "rights",
        "source_identity",
        "status",
        "title",
        "title_basis"
      ],
      "type": "object"
    },
    "questionRights": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "minLength": 1,
          "type": "string"
        },
        "derivation": {
          "minLength": 1,
          "type": "string"
        },
        "license_spdx": {
          "enum": [
            "Apache-2.0",
            "CC-BY-4.0",
            "CC-BY-SA-4.0"
          ]
        },
        "retained_bytes": {
          "const": true
        },
        "retention_permission": {
          "const": "redistribution-permitted-under-license"
        },
        "source_locator": {
          "minLength": 1,
          "type": "string"
        },
        "source_rights_class": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "attribution",
        "derivation",
        "license_spdx",
        "retained_bytes",
        "retention_permission",
        "source_locator",
        "source_rights_class"
      ],
      "type": "object"
    },
    "rightsEntry": {
      "additionalProperties": true,
      "properties": {
        "attribution": {
          "minLength": 1,
          "type": "string"
        },
        "license_spdx": {
          "minLength": 1,
          "type": "string"
        },
        "retention_permission": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "attribution",
        "license_spdx",
        "retention_permission"
      ],
      "type": "object"
    }
  }
}
